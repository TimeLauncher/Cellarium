%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8c5c9c8641762d74eac5a3509e51a5fa, type: 3}
  m_Name: A06_TCellFirst
  m_EditorClassIdentifier:
  defaultJob: "T세포"
  defaultSpeaker: "티온"
  lines:
  - job:
    speaker:
    text: "네가 A03에서 잡혀 온 그 화이트셀인가."
    charIntervalOverride: 0
  - job:
    speaker:
    text: "겁먹을 것 없다. 여긴 심장 방어선 사령부다."
    charIntervalOverride: 0
  - job:
    speaker:
    text: "우리는 감염원의 위치를 알고도 손을 못 대고 있다. 좁은 틈으로는 우리 몸이 들어가지 않아서지."
    charIntervalOverride: 0
  - job:
    speaker:
    text: "하지만 너는 다르다. 몸을 나눌 수 있는 셀이라면 이야기가 달라진다."
    charIntervalOverride: 0
  - job:
    speaker:
    text: "심장으로 가는 길을 열어 두겠다. 그 대신 네가 안쪽을 봐 줘야겠다."
    charIntervalOverride: 0
